{
  "manifest_version": 3,
  "name": "Synpo GTM Lead Capture",
  "version": "0.2.0",
  "description": "Capture the open Instagram profile (public snapshot) and verified accounts into the Synpo GTM pipeline. No provider secrets, no automatic enrichment.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Synpo GTM Lead Capture",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["lib.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
