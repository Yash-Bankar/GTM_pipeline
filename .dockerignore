# Keep the Docker build context small and secret-free.

# Secrets / env
.env
.env.*
!.env.example
**/secrets/
**/service-account*.json
**/credentials.json
**/token.json

# Python
backend/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Node / Next
frontend/node_modules/
frontend/.next/
frontend/out/

# Tests / docs / tooling
tests/
docs/
extension/
scripts/

# VCS / OS
.git/
.gitignore
**/.DS_Store
**/Thumbs.db

# Local runtime data
data/
*.log
