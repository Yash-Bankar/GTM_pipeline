# Synpo GTM dashboard - frontend environment (copy to .env.local)
# Server-only. Never expose provider/backend secrets to the browser.

# Base URL of the Python API (server-side only).
API_BASE_URL=http://127.0.0.1:8000

# Shared secret sent to the API as `x-api-key` (must match backend API_KEY).
BACKEND_API_KEY=

# Dashboard access gate. If unset, the gate is disabled (local dev).
DASHBOARD_PASSWORD=
# Optional HMAC secret for the session cookie (falls back to DASHBOARD_PASSWORD).
SESSION_SECRET=
