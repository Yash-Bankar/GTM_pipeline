# Synpo GTM Automation - environment template
# Copy to .env and fill in real values. NEVER commit .env or real secrets.

# --- Runtime ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Backend API ---
API_HOST=127.0.0.1
API_PORT=8000
# When set, API requests must send a matching `x-api-key` header (the dashboard does).
API_KEY=

# --- Frontend (Next.js) ---
# Browser-visible base URL for the API (safe to expose).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Server-side base URL used by Next.js server code (not exposed to the browser).
API_BASE_URL=http://127.0.0.1:8000

# --- Instagram data provider (HikerAPI) ---
HIKERAPI_BASE_URL=https://api.hikerapi.com/v2
HIKERAPI_KEY=
HIKERAPI_TIMEOUT_SECONDS=20
HIKERAPI_MAX_ATTEMPTS=4
HIKERAPI_BACKOFF_BASE_SECONDS=0.5
HIKERAPI_BACKOFF_MAX_SECONDS=10

# --- AI provider (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Usage controls
AI_ENABLED=true
AI_TEMPERATURE=0.4
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_SECONDS=60
AI_MAX_ATTEMPTS=3
# Optional rubric override (JSON: {"name","version","criteria":[{"name","weight","description"}]})
AI_RUBRIC_JSON=
# Evidence bounds sent to the model
AI_MAX_POSTS_EVIDENCE=10
AI_MAX_PAGES_EVIDENCE=5
AI_EVIDENCE_TEXT_CHARS=1500

# --- Google Sheets (source of truth) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_IG_LEADS_TAB=IG Leads
GOOGLE_SHEETS_DEDUP_TAB=Deduplicated Leads
GOOGLE_SHEETS_ENRICHED_TAB=instagram_leads_enriched
GOOGLE_SHEETS_OUTREACH_TAB=Outreach
GOOGLE_SHEETS_JOBS_TAB=Pipeline Jobs
GOOGLE_SHEETS_POSTS_TAB=Lead Posts
GOOGLE_SHEETS_WEBSITE_PAGES_TAB=Website Pages
GOOGLE_SHEETS_DOSSIERS_TAB=Dossiers
# Path to a Google service account JSON key file. The file itself is gitignored.
# Relative paths resolve against the repo root, then the backend directory.
GOOGLE_APPLICATION_CREDENTIALS=./backend/secrets/service-account.json

# Google Sheets client behaviour (timeouts, retries)
GOOGLE_SHEETS_REQUEST_TIMEOUT_SECONDS=30
GOOGLE_SHEETS_MAX_ATTEMPTS=5
GOOGLE_SHEETS_BACKOFF_BASE_SECONDS=0.5
GOOGLE_SHEETS_BACKOFF_MAX_SECONDS=30

# --- Profile media (recent posts/reels) ---
MEDIA_MAX_POSTS=12
MEDIA_MAX_PAGES=2

# --- Website enrichment (crawl + SSRF-safe fetch) ---
WEBSITE_MAX_PAGES=5
WEBSITE_MAX_LINKS_PER_PAGE=30
WEBSITE_TIMEOUT_SECONDS=10
WEBSITE_MAX_BYTES=2000000
WEBSITE_MAX_ATTEMPTS=2
WEBSITE_USER_AGENT=SynpoGTM/0.1

# --- Worker ---
WORKER_POLL_SECONDS=30
WORKER_STALE_MINUTES=30
WORKER_BATCH_SIZE=50
WORKER_CONCURRENCY=5

# --- Pipeline job retries ---
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_RETRY_BACKOFF_BASE_SECONDS=60
PIPELINE_RETRY_BACKOFF_MAX_SECONDS=3600
