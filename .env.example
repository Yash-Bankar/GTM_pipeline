# Synpo GTM Automation - environment template
# Copy to .env and fill in real values. NEVER commit .env or real secrets.

# --- Runtime ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Backend API ---
API_HOST=127.0.0.1
API_PORT=8000
# When set, API requests must send a matching `x-api-key` header (the dashboard does).
API_KEY=
# Comma-separated CORS origins allowed to call the API (the Chrome extension uses
# chrome-extension://<id>; "*" is fine for local dev, or list explicit origins).
CORS_ALLOW_ORIGINS=*

# NOTE: frontend (Next.js) variables are NOT read from this file. Next.js loads
# its own env from `frontend/.env.local` - see `frontend/.env.example`.

# --- Database (source of truth) ---
# Sync SQLAlchemy URL. Use host `db` inside docker compose; `localhost` for local dev.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/synpo

# --- Instagram data provider (HikerAPI) ---
HIKERAPI_BASE_URL=https://api.hikerapi.com/v2
HIKERAPI_KEY=
HIKERAPI_TIMEOUT_SECONDS=20
HIKERAPI_MAX_ATTEMPTS=4
HIKERAPI_BACKOFF_BASE_SECONDS=0.5
HIKERAPI_BACKOFF_MAX_SECONDS=10

# --- AI provider (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Usage controls
AI_ENABLED=true
AI_TEMPERATURE=0.4
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_SECONDS=60
AI_MAX_ATTEMPTS=3
# Optional rubric override (JSON: {"name","version","criteria":[{"name","weight","description"}]})
AI_RUBRIC_JSON=
# Evidence bounds sent to the model
AI_MAX_POSTS_EVIDENCE=10
AI_MAX_PAGES_EVIDENCE=5
AI_EVIDENCE_TEXT_CHARS=1500

# --- Profile media (recent posts/reels) ---
MEDIA_MAX_POSTS=12
MEDIA_MAX_PAGES=2

# --- Website enrichment (crawl + SSRF-safe fetch) ---
WEBSITE_MAX_PAGES=5
WEBSITE_MAX_LINKS_PER_PAGE=30
WEBSITE_TIMEOUT_SECONDS=10
WEBSITE_MAX_BYTES=2000000
WEBSITE_MAX_ATTEMPTS=2
WEBSITE_USER_AGENT=SynpoGTM/0.1

# --- Worker ---
# Idle poll interval (seconds). A hard minimum of 5s is enforced.
WORKER_POLL_INTERVAL=30
WORKER_STALE_MINUTES=30

# --- Pipeline job retries ---
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_RETRY_BACKOFF_BASE_SECONDS=60
PIPELINE_RETRY_BACKOFF_MAX_SECONDS=3600
