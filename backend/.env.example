# Backend/worker environment template.
#
# NOTE: the backend loads `.env` from the REPOSITORY ROOT (see ../.env.example).
# This file mirrors the backend-relevant variables for reference. Copy the
# repository-root `.env.example` to `.env` in production/local use.

# --- Runtime ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Backend API ---
API_HOST=127.0.0.1
API_PORT=8000
# The dashboard operator key (full administrative access).
API_KEY=
# Optional capture-scoped key for the extension (see ../.env.example).
CAPTURE_API_KEY=
CORS_ALLOW_ORIGINS=*

# --- Database (source of truth) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/synpo

# --- Instagram data provider (HikerAPI) ---
HIKERAPI_BASE_URL=https://api.hikerapi.com/v2
HIKERAPI_KEY=
HIKERAPI_TIMEOUT_SECONDS=20
HIKERAPI_MAX_ATTEMPTS=4
HIKERAPI_BACKOFF_BASE_SECONDS=0.5
HIKERAPI_BACKOFF_MAX_SECONDS=10

# --- AI provider (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_ENABLED=true
AI_TEMPERATURE=0.4
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_SECONDS=60
AI_MAX_ATTEMPTS=3
AI_RUBRIC_JSON=
AI_MAX_POSTS_EVIDENCE=10
AI_MAX_PAGES_EVIDENCE=5
AI_EVIDENCE_TEXT_CHARS=1500

# --- Profile media ---
MEDIA_MAX_POSTS=12
MEDIA_MAX_PAGES=2

# --- Website enrichment ---
WEBSITE_MAX_PAGES=5
WEBSITE_MAX_LINKS_PER_PAGE=30
WEBSITE_TIMEOUT_SECONDS=10
WEBSITE_MAX_BYTES=2000000
WEBSITE_MAX_ATTEMPTS=2
WEBSITE_USER_AGENT=SynpoGTM/0.1

# --- Worker ---
WORKER_POLL_INTERVAL=30
WORKER_STALE_MINUTES=30

# --- Pipeline job retries ---
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_RETRY_BACKOFF_BASE_SECONDS=60
PIPELINE_RETRY_BACKOFF_MAX_SECONDS=3600
